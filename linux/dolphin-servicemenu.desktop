[Desktop Entry]
Type=Service
ServiceTypes=KonqPopupMenu/Plugin
MimeType=image/jpeg;image/png;image/webp;image/gif;image/heic;image/heif;
Actions=pixforgeOpen;pixforgeCompress;pixforgeWebp;
X-KDE-Priority=TopLevel
X-KDE-Submenu=Pixforge
Icon=pixforge

[Desktop Action pixforgeOpen]
Name=Open with Pixforge
Icon=pixforge
Exec=__PIXFORGE_EXEC__ %F

[Desktop Action pixforgeCompress]
Name=Compress Image
Icon=pixforge
Exec=__PIXFORGE_EXEC__ --tool compress %F

[Desktop Action pixforgeWebp]
Name=Convert to WebP
Icon=pixforge
Exec=__PIXFORGE_EXEC__ --tool convert %F
